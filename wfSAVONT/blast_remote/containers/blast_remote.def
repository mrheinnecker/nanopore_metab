Bootstrap: docker
From: quay.io/biocontainers/blast:2.17.0--h66d330f_0

%labels
    Author nanopore_metab
    Description NCBI BLAST+ client for standalone remote ASV searches

%environment
    export PATH=/usr/local/bin:$PATH
    export LC_ALL=C

%post
    curl -L --fail --retry 3 \
        https://github.com/jqlang/jq/releases/download/jq-1.8.1/jq-linux-amd64 \
        -o /usr/local/bin/jq
    chmod 0755 /usr/local/bin/jq

%test
    curl --version
    jq --version

%runscript
    exec "$@"
